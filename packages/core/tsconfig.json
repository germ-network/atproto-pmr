{
	"compilerOptions": {
		"target": "es2022",
		"lib": ["es2022", "dom"],
		"module": "es2022",
		"moduleResolution": "bundler",
		"types": [],
		"noEmit": true,
		"isolatedModules": true,
		"forceConsistentCasingInFileNames": true,
		"strict": true,
		"skipLibCheck": true
	},
	"include": ["src/**/*"]
}
